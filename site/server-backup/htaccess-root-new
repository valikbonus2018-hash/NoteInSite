## Кодировка документов
AddDefaultCharset utf-8
#AddDefaultCharset koi8-u
#AddDefaultCharset windows-1251

## Файл индексного документа
#DirectoryIndex index.shtml index.html index.htm index.php

## Воспринимать файлы *.html как SSI
#AddHandler server-parsed .html

## Включить парсинг SSI выражений в устаревшем формате
#SSILegacyExprParser on

## Разрешение вывода содержимого каталога
#Options +Indexes

## Не писать в access.log информацию о файлах *.gif и *.jpg
#SetEnvIf Request_URI \.gif$ access_log
#SetEnvIf Request_URI \.jpg$ access_log

## --- NoteInSite: поддомен noteinsite.atmos.ho.ua отдаётся из папки /noteinsite/ ---
## Добавлено 17.09.2026. Правила срабатывают ТОЛЬКО для этого имени хоста,
## на atmos.ho.ua, www.atmos.ho.ua и bible.atmos.ho.ua не влияют.
<IfModule mod_rewrite.c>
  RewriteEngine On

  ## Тот же сайт по адресу с /noteinsite/ в пути — убираем дубль одним 301.
  ## Условие по THE_REQUEST проверяет исходный запрос браузера, поэтому
  ## внутренняя подстановка ниже не зацикливает редирект.
  RewriteCond %{HTTP_HOST} ^(www\.)?noteinsite\.atmos\.ho\.ua$ [NC]
  RewriteCond %{THE_REQUEST} \s/+noteinsite/ [NC]
  RewriteRule ^noteinsite/(.*)$ /$1 [R=301,L]

  ## Основное правило: внутренняя подстановка каталога, адрес в браузере не меняется.
  RewriteCond %{HTTP_HOST} ^(www\.)?noteinsite\.atmos\.ho\.ua$ [NC]
  RewriteCond %{REQUEST_URI} !^/noteinsite/
  RewriteRule ^(.*)$ /noteinsite/$1 [L]
</IfModule>
